# LOCAL DEVELOPMENT API CONFIGURATION
# Copy this file to .env.local and update with your local backend URL
# Do NOT commit the .env file to Git

# Local backend running on port 5000
REACT_APP_API_URL=http://localhost:5000/api

# NOTE: 
# - During local development, this points to http://localhost:5000
# - The backend must be running on http://localhost:5000 for API requests to work
# - In production (Vercel/Netlify), API calls are proxied via vercel.json and netlify.toml
#   to https://rubavu-today-backend.onrender.com/api
# - Do NOT use this environment variable in production builds
